{
  "name": "triplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "depcruise": "depcruise src --config",
    "depcruise:report": "depcruise src --config --output-type dot | dot -T svg > dependency-graph.svg",
    "prepare": "husky",
    "e2e:postgres": "playwright test -c playwright.postgres.config.ts",
    "dev:postgres": "bash scripts/dev-postgres.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@svar-ui/react-gantt": "2.7.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "ag-grid-community": "33.3.2",
    "ag-grid-react": "33.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.563.0",
    "react": "19.3.0",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-joyride": "3.2.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "17.4.3",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "lint-staged": "16.2.7",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}
