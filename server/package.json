{
  "name": "triplan-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "depcruise": "depcruise src --config",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "tsx src/scripts/create-admin.ts",
    "db:migrate-from-json": "tsx src/scripts/migrate-to-postgres.ts",
    "verify:external-tool": "tsx src/scripts/verify-external-tool.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "17.4.3",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}
